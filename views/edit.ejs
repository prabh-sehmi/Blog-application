<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Profile</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body style="background:#0f0f12; min-height:100vh; font-family:Arial, sans-serif; color:white; display:flex; justify-content:center; padding-top:60px;">

    <div style="width:600px;">

        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:25px;">
        <a href="/logout" style="text-decoration:none; color:#ef4444; font-size:14px;">Logout</a>
        </div>

        <div style="background:#1f1f23; padding:20px; border-radius:10px; margin-bottom:30px; box-shadow:0 10px 25px rgba(0,0,0,0.3);">

            <h5 style="margin-bottom:15px;">Edit your post</h5>

            <form method="post" action="/update/<%= post._id%>">

                <textarea 
                    placeholder="What's on your mind?"
                    name="content"
                    style="width:100%; height:100px; background:#2a2a2e; border:none; border-radius:8px; padding:10px; color:white; resize:none; margin-bottom:15px;"
                    ><%= post.content%></textarea>

                <input 
                    type="submit" 
                    value="Update Post"
                    style="background:#ffee00; border:none; padding:8px 15px; border-radius:6px; color:rgb(0, 0, 0); cursor:pointer;"
                    >

            </form>

        </div>

        
        
        </div>

        </div>

    </div>

</body>
</html>