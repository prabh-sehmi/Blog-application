<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Profile</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body style="background:#0f0f12; min-height:100vh; font-family:Arial, sans-serif; color:white; display:flex; justify-content:center; padding-top:60px;">

    <div style="width:600px;">

        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:25px;">
        <h3 style="margin:0;">Hello, <%= user.name %></h3>
        <a href="/logout" style="text-decoration:none; color:#ef4444; font-size:14px;">Logout</a>
        </div>

        <div style="background:#1f1f23; padding:20px; border-radius:10px; margin-bottom:30px; box-shadow:0 10px 25px rgba(0,0,0,0.3);">

            <h5 style="margin-bottom:15px;">Create new post</h5>

            <form method="post" action="/post">

                <textarea 
                    placeholder="What's on your mind?"
                    name="content"
                    style="width:100%; height:100px; background:#2a2a2e; border:none; border-radius:8px; padding:10px; color:white; resize:none; margin-bottom:15px;"
                    ></textarea>

                <input 
                    type="submit" 
                    value="Create Post"
                    style="background:#2563eb; border:none; padding:8px 15px; border-radius:6px; color:white; cursor:pointer;"
                    >

            </form>

        </div>


        <h4 style="margin-bottom:15px;">Your Posts</h4>
        <% user.posts.reverse().forEach(function(post){ %>
            <div class="postcontainer">

            <div style="background:#1f1f23; padding:20px; border-radius:10px; margin-bottom:15px; box-shadow:0 10px 25px rgba(0,0,0,0.3);">

                <h5 style="margin-bottom:8px;">@<%= user.username %></h5>

                <p style="color:#a1a1aa; line-height:1.5;">
                <%= post.content %>
                </p>

                <div style="display:flex; gap:20px; margin-top:15px;">

                    <small><%= post.likes.length %> likes</small>

                    <a href="/like/<%= post._id %>" style="text-decoration:none; color:#3b82f6;">
                        <%= post.likes.indexOf(user._id) === -1 ? "Like" : "Unlike" %>
                    </a>

                    <a href="/edit/<%= post._id %>" style="text-decoration:none; color:#f59e0b;">Edit</a>

                </div>

                

             </div>

        </div>
        <% })%>    
        
                

            </div>

        </div>

    </div>

</body>
</html>