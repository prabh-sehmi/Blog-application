<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Create User</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body style="background:#0f0f12; height:100vh; display:flex; align-items:center; justify-content:center; font-family:Arial, sans-serif;">

<div style="background:#1f1f23; padding:40px; width:380px; border-radius:10px; box-shadow:0 10px 30px rgba(0,0,0,0.4); color:white;">

<h3 style="margin-bottom:25px; text-align:center;">Create Account</h3>

<form action="/upload" method="post" enctype="multipart/form-data">

<div class="mb-3">
<input type="file" name="image"
style="width:100%; padding:10px; border:none; border-radius:6px; background:#2a2a2e; color:white;">
</div>

<input type="submit" value="Upload file"
style="width:100%; padding:10px; border:none; border-radius:6px; background:#2563eb; color:white; font-weight:500; cursor:pointer;">

</form>

</div>

</body>
</html>